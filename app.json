{
  "expo": {
    "name": "Casper Universe",
    "slug": "casper-universe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/CASPERc.png",
    "scheme": "casperuniverse",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caspergroup.universe",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.caspergroup.universe",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logos/CASPERc.png",
        "backgroundColor": "#07070B"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logos/CASPERc.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Casper Universe to scan an authorized reward code."
        }
      ],
      "expo-font",
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
