{
  "name": "casper-universe-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:backend": "node scripts/verify-backend-config.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "verify": "npm run verify:backend && npm test && npm run typecheck && npm run vercel-build && npm run audit:production",
    "vercel-build": "EXPO_NO_TELEMETRY=1 npx expo export -p web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.14",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "tar": "7.5.22",
    "postcss": "8.5.25",
    "@xmldom/xmldom": "0.9.10",
    "uuid": "11.1.1",
    "nanoid": "3.3.18"
  },
  "private": true
}
